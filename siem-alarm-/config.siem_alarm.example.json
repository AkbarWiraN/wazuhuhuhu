{
  "opensearch_url": "https://127.0.0.1:9200",
  "username": "siem_alarm_service",
  "password_env": "WAZUH_PASS",
  "verify_ssl": true,
  "ca_cert": "/opt/wazuh-risk-scoring/root-ca.pem",
  "timeout": 60,
  "retry_attempts": 4,
  "retry_backoff_seconds": 1.0,
  "source_index": "wazuh-alerts-*",
  "destination_index_prefix": "siem-alarm",
  "template_name": "siem-alarm-template",
  "install_template": false,
  "assets_file": "/opt/wazuh-risk-scoring/assets.json",
  "log_file": "/opt/wazuh-risk-scoring/logs/siem_alarm_scoring.log",
  "lock_file": "/opt/wazuh-risk-scoring/logs/scoring.lock",
  "log_level": "INFO",
  "deduplication_mode": "coarse",
  "bucket_minutes": 60,
  "lookback_minutes": 60,
  "process_current_bucket_only": true,
  "lookback_overlap_minutes": 7,
  "escalation_log_enabled": true,
  "escalation_log_levels": ["Medium", "High", "Critical"],
  "threat_level_strategy": "max",
  "max_alerts_per_run": 50000,
  "page_size": 1000,
  "scroll_keepalive": "2m",
  "min_rule_level": null,
  "excluded_rule_ids": [],
  "excluded_rule_groups": [],
  "evidence_sample_limit": 20,
  "evidence_top_limit": 10,
  "rule_overrides": {}
}
